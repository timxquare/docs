# Copy this file to ".env" and fill in your real values.
# (In a terminal:  cp .env.example .env  then edit .env)

# ---- REQUIRED ----

# Your PromoteKit API key. Get it from the PromoteKit dashboard:
# Settings -> API Keys.
PROMOTEKIT_API_KEY=

# Your Tolt API key. Get it from the Tolt dashboard:
# Settings -> Integrations.
TOLT_API_KEY=

# The Tolt program every imported affiliate should be added to.
# Find it in your Tolt dashboard (Programs), or by listing programs via the API.
TOLT_PROGRAM_ID=

# ---- OPTIONAL ----

# Put all imported partners into a specific Tolt group.
# TOLT_GROUP_ID=

# Set to "true" ONLY if PromoteKit returns money already in cents.
# Leave as-is (false) if it returns dollars like 49.00.
# PK_AMOUNTS_IN_CENTS=false

# How many records to request per page (max 100).
# PAGE_SIZE=100

# Delay in milliseconds between writes to Tolt (throttling).
# WRITE_DELAY_MS=350

# Override API base URLs (normally not needed).
# PROMOTEKIT_BASE_URL=https://www.promotekit.com/api/v1
# TOLT_BASE_URL=https://api.tolt.com/v1

# Override PromoteKit endpoint paths if --inspect shows they differ.
# PK_AFFILIATES_PATH=/affiliates
# PK_REFERRALS_PATH=/referrals
# PK_REFERRALS_PER_AFFILIATE_PATH=/affiliates/{id}/referrals
